# Cluely Meeting Assistant - Environment Configuration

# Server Port (Default: 3000)
PORT=3000

# Optional: Real-Time Cloud Speech-to-Text (Deepgram Nova-3 Live)
# Get a free API key with $200 credits at https://console.deepgram.com
DEEPGRAM_API_KEY=

# Multi-Provider AI Configuration
# Google Gemini (Direct API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# OpenRouter Free Tier
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# DeepSeek Direct API
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Optional: Cloud Speech-to-Text
DEEPGRAM_API_KEY=

